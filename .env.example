# Name of your system, shown in the UI, notifications and share messages (WhatsApp, mural bot, etc.).
# Each installation should set its own — never hardcode a specific group's name in the source code.
APP_NAME="Meu Racha"

# Avatar generation (AI) — provider is picked automatically by server/avatarProvider.ts:
# OPENROUTER_API_KEY takes priority if set; falls back to GEMINI_API_KEY otherwise.

# Option A (recommended): OpenRouter — single key routes to many providers/models,
# pay-as-you-go billing (avoids Gemini's free-tier image quota, which is often 0).
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# Model slug to use for avatar generation (must support image OUTPUT, not just image input).
# Browse image-capable models at: https://openrouter.ai/models?output_modalities=image
# Verified working end-to-end (real test, high-quality result): "openai/gpt-image-1".
OPENROUTER_MODEL="openai/gpt-image-1"
# Note: "google/gemini-2.5-flash-image" is also available on OpenRouter, but in testing it was
# routed through Google's own free "Google AI Studio" tier, which hit the same 0-quota error as
# calling Gemini directly (Option B below) — using it here doesn't reliably avoid that problem.
# Optional: comma-separated OpenRouter provider slugs to skip when routing a model (e.g. if a
# free/rate-limited upstream keeps getting picked). Check available providers/slugs at the model's
# page on https://openrouter.ai/models. Not needed for openai/gpt-image-1 (tested without it).
# OPENROUTER_IGNORE_PROVIDERS="google-ai-studio"

# Option B: call Gemini directly (used only if OPENROUTER_API_KEY is not set).
# Get your key from: https://ai.google.dev — note the free tier often has 0 quota for
# image-generation models; you may need billing enabled on the Google Cloud project.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App URL (set to your Render domain in production)
APP_URL="http://localhost:3000"

# Supabase Configuration (Required for database, auth, and storage)
# Get these values from your Supabase project settings:
# Project URL: Settings → API → Project URL
# Service Role Key: Settings → API → Service Role Secret (use this for backend)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# CORS allowed origins (comma-separated, local dev + production)
ALLOWED_ORIGINS="http://localhost:3000"

# JWT signing secret (Required — used to sign session tokens issued at login)
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same value across environments; never commit the real value.
JWT_SECRET="GENERATE_A_RANDOM_SECRET"

# Feature Flag for Avatar Generation using AI
ENABLE_AVATAR_AI=false

# E-mail transacional (usado hoje só para recuperação de senha e confirmação de cadastro).
# TurboSMTP API V2 via HTTPS — Consumer Key e Consumer Secret do painel TurboSMTP.
# Se TURBO_API_KEY não estiver configurado, a recuperação de senha fica indisponível
# (a tela avisa o usuário a procurar um admin).
# Obtenha suas credenciais em: https://painel.turbo-smtp.com -> API -> Consumer
TURBO_API_KEY=""
TURBO_API_SECRET=""
# Remetente exibido no e-mail.
EMAIL_FROM="Meu Racha <naoresponda@seudominio.com>"

# Node environment (set to "production" on Render)
NODE_ENV="development"
