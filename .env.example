# Gemini API (Required for avatar generation)
# Get your key from: https://ai.google.dev
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App URL (set to your Render domain in production)
APP_URL="http://localhost:3000"

# Supabase Configuration (Required for database, auth, and storage)
# Get these values from your Supabase project settings:
# Project URL: Settings → API → Project URL
# Service Role Key: Settings → API → Service Role Secret (use this for backend)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# CORS allowed origins (comma-separated, local dev + production)
ALLOWED_ORIGINS="http://localhost:3000"

# JWT signing secret (Required — used to sign session tokens issued at login)
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same value across environments; never commit the real value.
JWT_SECRET="GENERATE_A_RANDOM_SECRET"

# Feature Flag for Avatar Generation using AI
ENABLE_AVATAR_AI=false

# Node environment (set to "production" on Render)
NODE_ENV="development"
